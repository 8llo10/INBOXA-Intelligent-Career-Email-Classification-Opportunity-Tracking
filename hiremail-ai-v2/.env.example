DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiremail_ai
APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=hiremail_session
SESSION_DAYS=30
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
CRON_SECRET=replace-with-long-random-secret
GMAIL_SYNC_QUERY=newer_than:30d -in:spam -in:trash
GMAIL_SYNC_MAX_RESULTS=100
AI_INTENT_THRESHOLD=0.36
AI_FIELD_THRESHOLD=0.32
